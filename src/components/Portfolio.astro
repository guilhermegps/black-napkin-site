---
import { media } from '../data/media';
import { products } from '../data/products';
import type { Dictionary } from '../i18n';
import Icons from './icons/Icons.astro';

type Props = {
  t: Dictionary['portfolio'];
};

const { t } = Astro.props;
const product = products.calcinvest;
---

<section id="portfolio" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-3 text-ink-muted">{t.subtitle}</p>
    </div>

    <article class="mt-12 overflow-hidden rounded-2xl border border-border bg-surface-elevated/70">
      <div class="grid gap-8 p-6 md:grid-cols-[1.15fr_0.85fr] md:p-8">
        <div>
          <div class="flex items-center gap-4">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent text-accent-ink">
              <Icons name="money" class="h-7 w-7" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-accent">{t.productEyebrow}</p>
              <h3 class="font-display text-2xl text-ink md:text-3xl">{product.name}</h3>
              <p class="text-sm text-ink-muted">{t.product.tagline}</p>
            </div>
          </div>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-muted">{t.product.description}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={product.url}
              class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-accent-ink transition hover:brightness-110"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.productCta}
              <Icons name="arrow" class="h-4 w-4" />
            </a>
            <a
              href={product.github}
              class="inline-flex items-center rounded-full border border-border px-5 py-3 text-sm font-semibold text-ink transition hover:border-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.productGithub}
            </a>
          </div>
          <p class="mt-4 max-w-xl text-xs leading-relaxed text-ink-muted">{t.product.note}</p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2 md:grid-cols-1">
          {
            t.product.features.map((feature) => (
              <li class="rounded-xl border border-border bg-surface/60 p-4">
                <h4 class="font-semibold text-ink">{feature.title}</h4>
                <p class="mt-1 text-sm leading-relaxed text-ink-muted">{feature.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <ul class="mt-5 grid gap-5 md:grid-cols-3">
      {
        t.cases.map((item, index) => (
          <li class="flex flex-col overflow-hidden rounded-2xl border border-border bg-surface-elevated/70">
            <div class="relative aspect-[16/10] overflow-hidden bg-surface">
              <img
                src={media.cases[index]}
                alt=""
                width="1444"
                height="822"
                class="h-full w-full object-cover object-top"
                loading="lazy"
              />
              <span class="absolute bottom-4 left-4 rounded-full bg-surface/85 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent backdrop-blur">
                {item.tag}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-xl text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
