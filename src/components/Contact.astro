---
import { contact } from '../data/contact';
import type { Dictionary } from '../i18n';
import Icons from './icons/Icons.astro';

type Props = {
  t: Dictionary['contact'];
};

const { t } = Astro.props;

const items = [
  {
    icon: 'mail' as const,
    label: t.email,
    value: contact.email,
    cta: t.ctaEmail,
    href: `mailto:${contact.email}`,
    external: false,
    primary: true,
    conversion: true,
  },
  {
    icon: 'whatsapp' as const,
    label: t.whatsapp,
    value: t.whatsappValue,
    cta: t.ctaWhatsapp,
    href: contact.whatsappUrl,
    external: true,
    primary: false,
    conversion: true,
  },
  {
    icon: 'map' as const,
    label: t.address,
    value: `${contact.address.line1}\n${contact.address.line2}\nCEP ${contact.address.cep}`,
    cta: t.ctaMap,
    href: contact.address.mapsUrl,
    external: true,
    primary: false,
    conversion: false,
  },
];
---

<section id="contato" class="scroll-mt-24 border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl tracking-tight text-ink md:text-4xl">{t.title}</h2>
      <p class="mt-3 text-ink-muted">{t.subtitle}</p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        items.map((item) => (
          <li class="flex">
            <a
              href={item.href}
              class:list={[
                'group flex min-h-[15rem] w-full flex-col rounded-2xl border p-7 transition',
                item.primary
                  ? 'border-accent/60 bg-accent-soft hover:border-accent'
                  : 'border-border bg-surface-elevated/70 hover:border-accent/60',
              ]}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              data-ads-conversion={item.conversion ? '' : undefined}
            >
              <span
                class:list={[
                  'inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full',
                  item.primary ? 'bg-accent text-accent-ink' : 'bg-accent-soft text-accent',
                ]}
              >
                <Icons name={item.icon} class="h-5 w-5" />
              </span>

              <span class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">{item.label}</span>
              <span class="mt-2 whitespace-pre-line text-lg font-semibold leading-snug text-ink [overflow-wrap:anywhere]">
                {item.value}
              </span>

              <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-semibold text-accent">
                {item.cta}
                <Icons name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <script is:inline>
    document.querySelectorAll('[data-ads-conversion]').forEach(function (link) {
      link.addEventListener('click', function () {
        if (typeof gtag !== 'function') return;
        gtag('event', 'conversion', {
          send_to: 'AW-18571536602/HbQaCJyPprcdENrRzJdF',
        });
      });
    });
  </script>
</section>
